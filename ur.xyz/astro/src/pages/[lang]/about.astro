---
// /about, the protocol and its core contributors, in the site's other languages: the same route as the English
// page (components/routes/AboutRoute.astro), built per language once the
// `about` page group is localized.
import { localizedStaticPaths } from '../../lib/route-localization.js';
import AboutRoute from '../../components/routes/AboutRoute.astro';

export function getStaticPaths() {
    return localizedStaticPaths('about');
}
---
<AboutRoute lang={Astro.params.lang} />
