---
import DocPage from '../../components/routes/DocPage.astro';
import { docs } from '@react/lib/docs.js';
import { DOC_PAGE_PATHS } from '@react/lib/docs-shared.js';

export function getStaticPaths() {
    // A document published as its own page (the legal documents, at /terms,
    // /privacy and /vdp) gets no second copy under /docs.
    return docs.filter(d => d.slug && !DOC_PAGE_PATHS[d.slug]).map(d => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
---
<DocPage slug={slug} lang="en" />
