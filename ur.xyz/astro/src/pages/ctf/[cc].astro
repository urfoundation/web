---
// /ctf/<cc> — a country's capture the flag page in English, one for each of
// the 249 ISO 3166-1 codes of the epoch's snapshot: the page is
// components/routes/CtfCountryRoute.astro, which [lang]/ctf/[cc].astro renders
// in the other site languages.
import CtfCountryRoute from '../../components/routes/CtfCountryRoute.astro';
import { CTF } from '@react/components/pages/ctf/data.js';

export function getStaticPaths() {
    return CTF.countries.map((c) => ({ params: { cc: c.code } }));
}

const { cc } = Astro.params;
---
<CtfCountryRoute lang="en" cc={cc} />
