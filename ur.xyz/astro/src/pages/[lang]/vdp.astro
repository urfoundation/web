---
// /<lang>/vdp: the translation of the legal page /vdp, built in every
// language once the docs page group is localized. It says that the English
// page is the authoritative text and links it (components/LegalPage.astro).
import LegalPage from '../../components/LegalPage.astro';
import { localizedStaticPaths } from '../../lib/route-localization.js';

export function getStaticPaths() {
    return localizedStaticPaths('docs');
}

const { lang } = Astro.params;
---
<LegalPage lang={lang} doc="vdp" />
