---
/**
 * Shared shell for the legal document pages (terms | privacy | vdp) and their
 * translations (/<lang>/terms, …), built once the docs page group is
 * localized (react/src/i18n/pages/docs/group.js).
 *
 * The English page renders the canonical document (docs/legal/*.md, through
 * the generated react/src/data/legal.js). A translated page renders the
 * translation (react/src/i18n/pages/docs/corpus/<lang>/legal/) with the same
 * converter (scripts/legal-md.mjs), opens with a note that the English page
 * is the authoritative text, linking it, and gives the revision date in its
 * language. The markdown twin (/terms.md) is the English document's and
 * alternates the English page only.
 */
import Base from '../layouts/Base.astro';
import DisclaimerStatic from './DisclaimerStatic.astro';
import NavIsland from '../islands/NavIsland.jsx';
import Section from './Section.astro';
import FooterStatic from './FooterStatic.astro';

import '@react/components/Nav.css';
import '@react/components/Legal.css';
import { LEGAL_DOCS } from '@react/data/legal';
import { docIn, docsCopy } from '@react/lib/docs-i18n.js';
import { legalRevisedDate, translatedLegal } from '@react/lib/legal-i18n.js';
import { interpolate } from '@react/i18n/format.js';
import { getDict } from '../lib/i18n.js';

interface Props {
    t?: any;
    lang?: string;
    doc: 'terms' | 'privacy' | 'vdp';
}

const { lang = 'en', doc } = Astro.props;
const english = lang === 'en';
const t = Astro.props.t || await getDict(lang);
const words = docsCopy(lang).legal;
// the English document from the generated data module (docs/legal/*.md is
// canonical); a translation from its markdown
const d = english ? LEGAL_DOCS[doc] : translatedLegal(docIn(`legal/${doc}`, lang).content);
// the revision date of the English document, in the page's language
const updated = LEGAL_DOCS[doc].updated && interpolate(words.revised, { date: legalRevisedDate(LEGAL_DOCS[doc].updated, lang) });
// the i18n entry supplies the meta description
const meta = t.legal[doc];
// the document as markdown, for agents (scripts/generate-agent-assets.mjs)
const twin = english ? { href: `/${doc}.md`, type: 'text/markdown' } : null;
---
<Base title={`${meta.title || d.title} — UR`} description={meta.body} lang={lang} alternate={twin}>
    <div class="app">
        <DisclaimerStatic t={t} />
        <NavIsland lang={lang} client:idle={{ timeout: 1000 }} />

        <main class="section-page">
            <Section id={doc} eyebrow={t.legal.eyebrow} title={d.title} headingLevel="h1">
                {/* following the English link chooses English: Base.astro records data-lang-choice */}
                {!english && <p class="legal-translation-note" role="note">{words.notice} <a href={`/${doc}`} hreflang="en" data-lang-choice="en">{words.english}</a></p>}
                {updated && <p class="legal-updated">{updated}</p>}
                <div class="legal-doc" set:html={d.html} />
            </Section>
        </main>

        <FooterStatic t={t} lang={lang} />
    </div>
</Base>
