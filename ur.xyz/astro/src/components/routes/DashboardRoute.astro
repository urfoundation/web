---
// /dashboard ("UR Stats"), UR's network and SN25 stats read live, in any site
// language: pages/dashboard.astro renders it in English, and its translations
// render it at /<lang>/dashboard.
//
// The page is the React component the SPA renders for this route
// (react/src/components/pages/Dashboard.jsx), rendered on the server here and
// hydrated on load. It is standalone (this shell, not the site's Base layout),
// so it writes its own head: language and direction, title, description,
// canonical, language alternates and social cards, as Base.astro writes them
// for the site's other pages. react/src/components/pages/dashboard/loader.js
// builds the data in the visitor's browser from grafana.bringyour.com (public
// dashboard + stats.json) and Bittensor mainnet (the public RPC, as /reserve
// reads it), on top of /dashboard/history.json, the daily history
// scripts/dashboard-history.mjs keeps. Linked from the nav and footer and
// listed in the sitemap. Its words are the `dashboard` copy units
// (react/src/i18n/pages/dashboard/).
import DashboardPage from '@react/components/pages/Dashboard.jsx';
import { loadPageCopy } from '@react/i18n/page-copy.js';
import { LANG_CODES } from '../../lib/i18n.js';
import { alternatesFor, storedLanguageRedirectScript } from '../../lib/route-localization.js';

interface Props {
    lang?: string;
}

const { lang = 'en' } = Astro.props;
const { meta } = (await loadPageCopy('dashboard'))(lang);
const SITE_ORIGIN = 'https://ur.xyz';
const url = lang === 'en' ? `${SITE_ORIGIN}/dashboard` : `${SITE_ORIGIN}/${lang}/dashboard`;
// every language's page and x-default (English), once the dashboard group is
// localized; none while it is English-only
const alternates = alternatesFor('/dashboard').map(({ hreflang, path }) => ({ hreflang, href: new URL(path, SITE_ORIGIN).href }));
const localized = alternates.length > 0;
// as Base.astro names them (Spanish es_LA: the Spanish pages are neutral Latin American Spanish)
const OG_LOCALES: Record<string, string> = { en: 'en_US', ru: 'ru_RU', ar: 'ar_AR', zh: 'zh_CN', de: 'de_DE', es: 'es_LA' };
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{meta.title}</title>
<meta name="description" content={meta.description}>
<meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href={url}>
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
<meta name="theme-color" content="#101010">
<meta property="og:site_name" content="UR">
<meta property="og:title" content={meta.title}>
<meta property="og:description" content={meta.description}>
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:image" content="https://ur.xyz/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={meta.title}>
{localized && <meta property="og:locale" content={OG_LOCALES[lang]}>}
{localized && LANG_CODES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@urnetwork">
<meta name="twitter:title" content={meta.title}>
<meta name="twitter:description" content={meta.description}>
<meta name="twitter:image" content="https://ur.xyz/og.png">
<link rel="preconnect" href="https://grafana.bringyour.com" crossorigin>
{/* a visitor who chose another language reads the page in it (Base.astro) */}
{localized && <script is:inline set:html={storedLanguageRedirectScript()} />}
</head>
<body class="is-loading">
<DashboardPage lang={lang} client:load />
</body>
</html>
