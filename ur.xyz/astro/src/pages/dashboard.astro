---
// /dashboard — UR's network and SN25 stats, read live.
//
// The page is the React component the SPA renders for this route
// (react/src/components/pages/Dashboard.jsx), rendered on the server here and
// hydrated on load. It is standalone (this shell, not the site's Base layout):
// react/src/components/pages/dashboard/loader.js builds the data in the
// visitor's browser from grafana.bringyour.com (public dashboard + stats.json)
// and Bittensor mainnet (the public RPC, as /reserve reads it), on top of
// /dashboard/history.json, the daily history scripts/dashboard-history.mjs
// keeps. Hidden until launch: noindex, nofollow, not in the nav or sitemap.
import DashboardPage from '@react/components/pages/Dashboard.jsx';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>UR Stats</title>
<link rel="preconnect" href="https://grafana.bringyour.com" crossorigin>
</head>
<body class="is-loading">
<DashboardPage client:load />
</body>
</html>
