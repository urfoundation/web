---
// /dashboard ("UR Stats"), UR's network and SN25 stats read live, in any site
// language: pages/dashboard.astro renders it in English, and its translations
// render it at /<lang>/dashboard.
//
// The page is the React component the SPA renders for this route
// (react/src/components/pages/Dashboard.jsx), rendered on the server here and
// hydrated on load. It is standalone (this shell, not the site's Base layout),
// so it writes its own head: language and direction, title, description,
// canonical and social cards. react/src/components/pages/dashboard/loader.js
// builds the data in the visitor's browser from grafana.bringyour.com (public
// dashboard + stats.json) and Bittensor mainnet (the public RPC, as /reserve
// reads it), on top of /dashboard/history.json, the daily history
// scripts/dashboard-history.mjs keeps. Linked from the nav and footer and
// listed in the sitemap. Its words are the `dashboard` copy units
// (react/src/i18n/pages/dashboard/).
import DashboardPage from '@react/components/pages/Dashboard.jsx';
import { loadPageCopy } from '@react/i18n/page-copy.js';

interface Props {
    lang?: string;
}

const { lang = 'en' } = Astro.props;
const { meta } = (await loadPageCopy('dashboard'))(lang);
const url = lang === 'en' ? 'https://ur.xyz/dashboard' : `https://ur.xyz/${lang}/dashboard`;
// as Base.astro names them; the English page has never declared its own
const OG_LOCALES: Record<string, string> = { ru: 'ru_RU', ar: 'ar_AR', zh: 'zh_CN', de: 'de_DE', es: 'es_ES' };
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{meta.title}</title>
<meta name="description" content={meta.description}>
<meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href={url}>
{/* hreflang: added by the lead after the infra merge */}
<meta name="theme-color" content="#101010">
<meta property="og:site_name" content="UR">
<meta property="og:title" content={meta.title}>
<meta property="og:description" content={meta.description}>
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:image" content="https://ur.xyz/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={meta.title}>
{OG_LOCALES[lang] && <meta property="og:locale" content={OG_LOCALES[lang]}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@urnetwork">
<meta name="twitter:title" content={meta.title}>
<meta name="twitter:description" content={meta.description}>
<meta name="twitter:image" content="https://ur.xyz/og.png">
<link rel="preconnect" href="https://grafana.bringyour.com" crossorigin>
</head>
<body class="is-loading">
<DashboardPage lang={lang} client:load />
</body>
</html>
