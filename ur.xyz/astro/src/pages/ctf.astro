---
// /ctf — capture the flag: reward slots in every country (sn CAPTURETHEFLAG.md
// §9.2; the design is sn's design/ctf/design.html, the build plan
// design/ctf/SEO.md §2 and §6).
//
// The page body is the React component the SPA renders for this route
// (react/src/components/pages/Ctf.jsx), rendered to static HTML from the
// epoch's snapshot (react/src/data/ctf-epoch.json, scripts/ctf-import.mjs),
// so every figure is in the HTML that search engines and AI crawlers read.
// Only the board hydrates (ctf/Board.jsx: the live bar's filters with their
// view transitions, sorting and the search, the tips, tap to expand, Shuffle
// and the visitor's country from /sn/ctf/here). Its first render is this
// one, and nothing in it varies by build: Easy wins is the epoch's draw and
// the card shows the biggest open pot, so the page's fingerprint, and its
// sitemap <lastmod>, change only when the data does. English-only, like
// /mainnet.
import Base from '../layouts/Base.astro';
import DisclaimerStatic from '../components/DisclaimerStatic.astro';
import NavIsland from '../islands/NavIsland.jsx';
import FooterStatic from '../components/FooterStatic.astro';
import CtfPage from '@react/components/pages/Ctf.jsx';
import Board from '@react/components/pages/ctf/Board.jsx';
import { CTF } from '@react/components/pages/ctf/data.js';
import { API_STATE, HUB_TITLE, SITE, hubDescription } from '@react/components/pages/ctf/model.js';
import { ctfOgImage } from '@react/components/pages/ctf/og.js';
import { epochBounds } from '@react/lib/epoch.js';
import en from '@react/i18n/en.js';
import { LASTMOD_TOKEN } from '../lib/lastmod.js';

import '@react/components/Nav.css';

const description = hubDescription(CTF);
// The data as a Dataset (Dataset Search), its distribution the JSON API.
const jsonLd = [{
    '@type': 'Dataset',
    '@id': `${SITE}/ctf#dataset`,
    name: 'URnetwork capture the flag: reward slots and pots by country',
    description: "Each epoch (one week), every one of the 249 ISO 3166-1 countries has five provider slots and five extender slots on URnetwork, Bittensor subnet 25. Per country, the data gives last epoch's winners and the units in each draw, the pot carried into this epoch for each role, and a newcomer's chance to win where all five slots were won. Amounts are in alpha, the subnet's token, before participants' costs.",
    url: `${SITE}/ctf`,
    dateModified: LASTMOD_TOKEN,
    isAccessibleForFree: true,
    creator: { '@id': `${SITE}/#org` },
    spatialCoverage: { '@type': 'Place', name: 'Worldwide' },
    // from the first epoch's start, on the site's time basis, onwards
    temporalCoverage: `${new Date(epochBounds(CTF.firstEpoch).startMs).toISOString().slice(0, 10)}/..`,
    variableMeasured: ['Provider slots won', 'Extender slots won', 'Units in the draw', 'Provider pot (alpha)', 'Extender pot (alpha)', 'Chance to win'],
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: API_STATE }],
}];
---
<Base
    title={HUB_TITLE}
    description={description}
    breadcrumbName="Capture the flag"
    lang="en"
    jsonLd={jsonLd}
    alternate={{ href: API_STATE, type: 'application/json' }}
    ogImage={ctfOgImage(CTF)}
>
    {/* the board's first chain of requests is the visitor's country */}
    <link slot="head" rel="preconnect" href="https://api.bringyour.com" crossorigin />

    <div class="app">
        <DisclaimerStatic t={en} />
        <NavIsland activeRoute="ctf" lang="en" client:idle={{ timeout: 1000 }} />

        <main class="section-page">
            {/* "Updated" states the sitemap's lastmod: the build fills the
                token in once the page is fingerprinted (src/lib/lastmod.js) */}
            <CtfPage updated={LASTMOD_TOKEN}>
                <Board slot="board" client:idle={{ timeout: 1500 }} />
            </CtfPage>
        </main>

        <FooterStatic t={en} lang="en" />
    </div>
</Base>
