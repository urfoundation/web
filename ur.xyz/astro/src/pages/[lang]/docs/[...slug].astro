// /<lang>/docs/<doc>: a document in another language, a page of the docs group
// (react/src/i18n/pages/docs/group.js), built once that group is localized.
// Until then nothing is built here: nginx serves a /<lang>/ page when the build
// has one and otherwise answers /<lang>/docs/<doc> with a 301 to /docs/<doc>, so
// a redirect stub built here would be served in place of that 301.
export function getStaticPaths() {
    return [];
}
