---
// /ctf/<cc> — a country's capture the flag page in English, one for each of
// the 249 ISO 3166-1 codes of the epoch's snapshot: the page is
// components/routes/CtfCountryRoute.astro, which [lang]/ctf/[cc].astro renders
// in the other site languages. A page that reads like another country page's
// but for the name is noindex (components/routes/ctf-paths.js decides it from
// this build's snapshot; the seo-audit decides again and checks the built pages).
import CtfCountryRoute from '../../components/routes/CtfCountryRoute.astro';
import { ctfCountryPaths } from '../../components/routes/ctf-paths.js';

export function getStaticPaths() {
    return ctfCountryPaths();
}

const { cc } = Astro.params;
const { noindex } = Astro.props;
---
<CtfCountryRoute lang="en" cc={cc} noindex={noindex} />
